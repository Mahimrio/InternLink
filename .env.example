# Compose-specific environment variables
# Copy this to .env and fill in values for local development

# PostgreSQL (local db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=internlink_dev

# Connection string for the API — uncomment the one you need:

# Option A: Local PostgreSQL (via Docker Compose)
# ConnectionStrings__SupabaseDb=Host=db;Port=5432;Database=internlink_dev;Username=postgres;Password=postgres;Include Error Detail=true

# Option B: Supabase direct connection (port 5432, for development)
# IPv6 only — use Option C if your machine lacks IPv6 connectivity
# ConnectionStrings__SupabaseDb=Host=db.<project-ref>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<password>;SSL Mode=Require;Trust Server Certificate=true

# Option C: Supabase pooled connection (port 6543, via IPv4 — recommended for local dev)
# ConnectionStrings__SupabaseDb=Host=aws-0-<region>.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.<project-ref>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true;Pooling=false

# ── Loading ──────────────────────────────────────────────────────────
# The .env file is loaded automatically by DotNetEnv when running `dotnet run`.
# Docker Compose also reads .env natively.