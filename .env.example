# InternLink Environment Configuration Template
# Copy this file to .env.development and fill in your values

# Application
APP_NAME=InternLink
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=internlink_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

# Database Connection String (alternative to individual params)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/internlink_dev?sslmode=disable

# Redis (Caching & Sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ISSUER=InternLink
JWT_AUDIENCE=InternLink-Users
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@internlink.com
SMTP_FROM_NAME=InternLink

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# File Storage (AWS S3 / MinIO)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=internlink-uploads
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# External APIs
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Background Jobs (Hangfire / BullMQ)
JOB_QUEUE_CONNECTION_STRING=redis://localhost:6379

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Feature Flags
FEATURE_GOOGLE_AUTH=true
FEATURE_LINKEDIN_AUTH=true
FEATURE_EMAIL_VERIFICATION=true
FEATURE_FILE_UPLOAD=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10