# Compose-specific environment variables
# Copy this to .env and fill in values for local development

# PostgreSQL (local db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=internlink_dev

# Connection string for the API — uncomment the one you need:

# Option A: Local PostgreSQL (via Docker Compose)
# ConnectionStrings__SupabaseDb=Host=db;Port=5432;Database=internlink_dev;Username=postgres;Password=postgres;Include Error Detail=true

# Option B: Supabase direct connection (port 5432, for development)
# ConnectionStrings__SupabaseDb=Host=<project>.supabase.co;Port=5432;Database=postgres;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true

# Option C: Supabase pooled connection (port 6543, for Render/production)
# ConnectionStrings__SupabaseDb=Host=<project>.supabase.co;Port=6543;Database=postgres;Username=<user>.pooler;Password=<password>;SSL Mode=Require;Trust Server Certificate=true

# To test Supabase instead of local db:
# 1. Uncomment Option B or C above with your real Supabase credentials
# 2. Run: docker compose up api (omit the db service — api connects directly to Supabase)